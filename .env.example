# Copy this file to .env and change the values if needed.

# Environment: development, production or test (default: development)
NODE_ENV=development

# HTTP port (default: 3000)
PORT=3000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://resume:resume@localhost:5432/resume

# Database container settings for Docker Compose.
# They must match DATABASE_URL.
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume
POSTGRES_PORT=5432

APP_PORT=3000
