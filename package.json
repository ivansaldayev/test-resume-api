{
  "name": "resume-api",
  "version": "0.0.1",
  "description": "NestJS + GraphQL + Prisma digital resume API (test task)",
  "author": "Ivan Saldayev <ivansaldayev@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivansaldayev/test-resume-api.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings && prisma validate && prisma format --check && git ls-files -z -co --exclude-standard -- '*.md' '*.yml' '*.yaml' | xargs -0 -r prettier --no-error-on-unmatched-pattern --check",
    "format": "biome check --write && prisma format && git ls-files -z -co --exclude-standard -- '*.md' '*.yml' '*.yaml' | xargs -0 -r prettier --no-error-on-unmatched-pattern --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.8",
    "graphql": "^16.14.2",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@apollo/protobufjs": false,
    "protobufjs": false,
    "ssh2": false,
    "cpu-features": false
  }
}
